    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.150",
    "@nuxt/eslint": "^1.10.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.14"
  },
  "allowScripts": {
